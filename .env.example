# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Vendor-neutral OpenTelemetry. Leave disabled locally unless a collector is
# configured. Production exporters use only standard OTEL_* settings.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=omniroute-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# NestJS API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://omniroute:change-me-local-only@localhost:5432/omniroute
DATABASE_TEST_URL=postgresql://omniroute:change-me-local-only@localhost:5432/omniroute_test
REDIS_URL=redis://localhost:6379
AI_ROUTER_URL=http://localhost:8001

# Credits are integer platform units. Provider pricing remains versioned Model
# Registry decimal strings; this is the server-side conversion policy.
DAILY_FREE_CREDITS=1000
PLATFORM_CREDITS_PER_USD=1000000

# Authentication (server-only except NEXT_PUBLIC_API_BASE_URL above)
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
AUTH_SESSION_ROTATION_MINUTES=15
# Leave unset for localhost. Set to a shared parent domain only when required.
AUTH_COOKIE_DOMAIN=

# FastAPI AI router
AI_ROUTER_HOST=0.0.0.0
AI_ROUTER_PORT=8001
AI_ROUTER_LOG_LEVEL=info
# Real providers are disabled by default and their server-only keys must remain
# in an untracked .env or secret manager. Enable each adapter deliberately.
AI_ROUTER_ENABLE_OPENAI=false
AI_ROUTER_ENABLE_ANTHROPIC=false
AI_ROUTER_ENABLE_GEMINI=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local PostgreSQL container only. Replace in an untracked .env file.
POSTGRES_USER=omniroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=omniroute
POSTGRES_PORT=5432

# Local Redis container
REDIS_PORT=6379
