# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Vendor-neutral OpenTelemetry. Leave disabled locally unless a collector is
# configured. Production exporters use only standard OTEL_* settings.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=omniroute-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com

# Web
WEB_PORT=3000
# Development default only. Vercel/production builds require an explicit HTTPS
# origin without /v1, credentials, query, or fragment. Rebuild when it changes.
NEXT_PUBLIC_API_URL=http://localhost:4000

# NestJS API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://omniroute:change-me-local-only@localhost:5432/omniroute
# Dedicated compose.integration.yaml instance only. Tests reject an inherited
# development DATABASE_URL; run them in a separate test shell (see the runbook).
DATABASE_TEST_URL=postgresql://omniroute_integration:integration-only@127.0.0.1:55432/omniroute_integration
# Production: set this manually to the existing Render Key Value private
# connection string. Redis remains ephemeral only; Supabase stores durable data.
REDIS_URL=redis://localhost:6379
# Shared limits are enforced per authenticated workspace/user. Production must
# provide REDIS_URL; Redis never holds durable conversations or credit state.
RATE_LIMIT_EXECUTIONS_PER_MINUTE=12
RATE_LIMIT_FILE_MUTATIONS_PER_MINUTE=20
AI_ROUTER_URL=http://localhost:8001
# mock is allowed only in development/test; production defaults to disabled.
# Real execution: multi (all enabled adapters), or one explicit provider.
# Supported real providers: openai, anthropic, gemini, groq, openrouter.
# Requires enabled reviewed registry entries with routing metadata and the router key below.
AI_EXECUTION_PROVIDER=mock
# Same random 32+ character server-only token in NestJS and FastAPI. No default secret.
AI_ROUTER_INTERNAL_TOKEN=
AI_ROUTER_TIMEOUT_MS=95000
AI_ROUTER_REQUEST_TIMEOUT_SECONDS=90
AI_ROUTER_MAX_OUTPUT_TOKENS=4096
AI_ROUTER_MAX_OUTPUT_BYTES=262144
AI_ROUTER_MAX_CONCURRENT_REQUESTS=16
AI_ROUTER_HEALTH_COOLDOWN_SECONDS=30
# Optional server deployment region; required for region-constrained models.
# AI_ROUTING_REGION=your-reviewed-region

# Credits are integer platform units. Provider pricing remains versioned Model
# Registry decimal strings; this is the server-side conversion policy.
DAILY_FREE_CREDITS=1000
PLATFORM_CREDITS_PER_USD=1000000

# File ingestion: source objects are private. Local/test uses deterministic
# in-memory storage and embeddings; production requires S3 and an approved
# embedding provider before files can become READY.
FILES_MAX_BYTES=5000000
FILES_MAX_EXTRACTED_TEXT_BYTES=10000000
FILES_MAX_PDF_PAGES=100
FILES_MAX_CHUNKS=256
FILES_PROCESSING_TIMEOUT_MS=30000
FILES_STALE_PROCESSING_MS=900000
FILES_STORAGE_DRIVER=memory
# Production only:
# FILES_STORAGE_DRIVER=s3
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ENDPOINT= # optional S3-compatible endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
EMBEDDING_PROVIDER=deterministic

# Authentication (server-only except NEXT_PUBLIC_API_URL above)
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
AUTH_SESSION_ROTATION_MINUTES=15
# Leave empty for localhost and same-origin proxy production deployments. When
# absent, production session cookies are host-only, Secure, HttpOnly, and
# SameSite=Lax. Set an owned shared parent domain only for app/api siblings.
# OAuth transaction cookies always remain host-only and callback-path scoped.
AUTH_COOKIE_DOMAIN=

# FastAPI AI router
AI_ROUTER_HOST=0.0.0.0
AI_ROUTER_PORT=8001
AI_ROUTER_LOG_LEVEL=info
# Real providers are disabled by default and their server-only keys must remain
# in an untracked .env or secret manager. Enable each adapter deliberately.
AI_ROUTER_ENABLE_OPENAI=false
AI_ROUTER_ENABLE_ANTHROPIC=false
AI_ROUTER_ENABLE_GEMINI=false
AI_ROUTER_ENABLE_GROQ=false
AI_ROUTER_ENABLE_OPENROUTER=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local PostgreSQL container only. Replace in an untracked .env file.
POSTGRES_USER=omniroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=omniroute
POSTGRES_PORT=5432

# Local Redis container
REDIS_PORT=6379
