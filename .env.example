# Runtime
NODE_ENV=development

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# NestJS API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://omniroute:change-me-local-only@localhost:5432/omniroute
REDIS_URL=redis://localhost:6379
AI_ROUTER_URL=http://localhost:8001

# FastAPI AI router
AI_ROUTER_HOST=0.0.0.0
AI_ROUTER_PORT=8001
AI_ROUTER_LOG_LEVEL=info

# Local PostgreSQL container only. Replace in an untracked .env file.
POSTGRES_USER=omniroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=omniroute
POSTGRES_PORT=5432

# Local Redis container
REDIS_PORT=6379
